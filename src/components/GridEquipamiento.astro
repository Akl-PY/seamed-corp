---
// src/components/EquipamientoSlider.astro
import { SITE_CONFIG } from "../config/site";
import CPAP from "../assets/products/CPAP.jpeg";
import oximetro from "../assets/products/oximetro.jpeg";
import glucometro from "../assets/products/glucometro.jpeg";
import { Image } from "astro:assets";
import equipamientoData from "../data/inicio/equipamiento.json";

// Mapeo de imágenes locales disponibles para los productos
const imageMap: Record<string, any> = {
  CPAP,
  oximetro,
  glucometro,
};
---

<section id="equipamiento" class="py-16 bg-surface w-full overflow-hidden">
  <div class="container mx-auto px-6">
    
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 data-aos="fade-up" data-aos-duration="500" class="text-theme text-2xl md:text-3xl font-bold">
        {equipamientoData.tituloSeccion}
      </h2>
    </div>

    <!-- Carrusel de Equipamiento -->
    <div class="relative group/slider max-w-6xl mx-auto">
      
      <!-- Contenedor Deslizable -->
      <div 
        id="equipmentSlider" 
        class="flex gap-6 overflow-x-auto scrollbar-none scroll-smooth py-4 px-1 snap-x snap-mandatory"
      >
        {equipamientoData.equipos.map((item, i) => {
          const productImg = imageMap[item.imageKey] || ventMecanico;
          return (
            <div 
              data-aos="fade-up" 
              data-aos-duration="500" 
              data-aos-delay={100 + (i % 3) * 100} 
              class="snap-start flex-none w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] group flex flex-col justify-between bg-bg border border-brand-gray/15 rounded-2xl p-5 shadow-sm hover:shadow-xl hover:border-accent transition-all duration-300 hover:-translate-y-1"
            >
              <div>
                <!-- Imagen -->
                <div class="aspect-video bg-surface rounded-xl mb-4 overflow-hidden relative">
                  <Image 
                    src={productImg} 
                    alt={item.name} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                    width={400}
                    height={225}
                  />
                  <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors duration-300"></div>
                </div>
                
                <!-- Categoría y Título -->
                <span class="inline-block text-accent text-[11px] font-bold uppercase tracking-wider mb-1">
                  {item.category}
                </span>
                <h3 class="text-base sm:text-lg font-bold text-main mb-2 leading-snug">
                  {item.name}
                </h3>
                <p class="text-xs sm:text-sm text-muted leading-relaxed line-clamp-3 mb-6">
                  {item.description}
                </p>
              </div>
              
              <!-- Botón de Consulta WhatsApp -->
              <a 
                href={`${SITE_CONFIG.social.whatsapp}/?text=Hola!%20Quiero%20saber%20m%C3%A1s%20sobre%20${encodeURIComponent(item.name)}`} 
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3 px-4 border border-accent text-accent font-bold text-xs sm:text-sm rounded-xl flex items-center justify-center gap-2 hover:bg-accent hover:text-main transition-all duration-300 shadow-sm active:scale-98"
              >
                <span>Consultar por WhatsApp</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          );
        })}
      </div>

      <!-- Botón Anterior -->
      <button 
        id="prevBtn" 
        disabled
        class="hidden sm:flex absolute -left-5 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-bg border border-brand-gray/20 shadow-lg items-center justify-center text-main hover:bg-accent hover:border-accent transition-all duration-200 z-10 focus:outline-none disabled:opacity-30 disabled:cursor-not-allowed disabled:pointer-events-none"
        aria-label="Anterior"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>

      <!-- Botón Siguiente -->
      <button 
        id="nextBtn" 
        class="hidden sm:flex absolute -right-5 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-bg border border-brand-gray/20 shadow-lg items-center justify-center text-main hover:bg-accent hover:border-accent transition-all duration-200 z-10 focus:outline-none disabled:opacity-30 disabled:cursor-not-allowed disabled:pointer-events-none"
        aria-label="Siguiente"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>

    </div>
  </div>
</section>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initEquipmentSlider() {
    const slider = document.getElementById("equipmentSlider");
    const prevBtn = document.getElementById("prevBtn") as HTMLButtonElement;
    const nextBtn = document.getElementById("nextBtn") as HTMLButtonElement;

    if (!slider || !prevBtn || !nextBtn) return;

    const getScrollAmount = () => {
      const firstCard = slider.firstElementChild as HTMLElement;
      return firstCard ? firstCard.offsetWidth + 24 : 320;
    };

    const updateButtons = () => {
      const scrollLeft = Math.ceil(slider.scrollLeft);
      const maxScroll = Math.floor(slider.scrollWidth - slider.clientWidth);
      prevBtn.disabled = scrollLeft <= 5;
      nextBtn.disabled = scrollLeft >= maxScroll - 5;
    };

    nextBtn.addEventListener("click", () => {
      const maxScroll = Math.floor(slider.scrollWidth - slider.clientWidth);
      if (slider.scrollLeft >= maxScroll - 5) return;
      slider.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
    });

    prevBtn.addEventListener("click", () => {
      if (slider.scrollLeft <= 5) return;
      slider.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
    });

    slider.addEventListener("scroll", updateButtons, { passive: true });
    updateButtons();
  }

  document.addEventListener("astro:page-load", initEquipmentSlider);
</script>