---
const services = [
  { title: "Oxigenoterapia", desc: "Concentradores de oxígeno de alto flujo para uso domiciliario.", url: "/catalogo/oxigenoterapia" },
  { title: "Ventilación Mecánica", desc: "Equipos CPAP y BIPAP con soporte técnico personalizado.", url: "/catalogo/ventilacion" },
  { title: "Insumos Médicos", desc: "Catálogo completo de descartables y accesorios esenciales.", url: "/catalogo/insumos" }
];
---

<section class="py-12 bg-surface">
  <div class="container mx-auto px-6">
    <h2 data-aos="fade-up" data-aos-duration="500" class="text-3xl font-bold text-main mb-12 text-center tracking-tight md:text-4xl ">Nuestras Soluciones</h2>
    <div class="grid md:grid-cols-3 gap-8">
      {services.map((s,i) => (
        <a href={s.url} data-aos="fade-up" data-aos-duration="500" data-aos-delay={i * 100} class="p-8 border border-gray-100 rounded-xl hover:shadow-xl transition-all duration-300 group">
          <h3 class="text-xl font-bold mb-4 text-[var(--color-theme)] group-hover:underline">{s.title}</h3>
          <p class="text-[var(--color-muted)]">{s.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>