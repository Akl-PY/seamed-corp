---
// src/components/ServicesHome.astro
import {
  ArrowUpRight,
  Wind,
  Moon,
  Activity,
  HeartPulse,
  Stethoscope,
  ShieldCheck,
} from "lucide-astro";
import serviciosData from "../data/servicios.json";

// Mapeo seguro de iconos según el ID del servicio
const iconMap: Record<string, any> = {
  oxigenoterapia: Wind,
  apnea: Moon,
  poligrafia: Activity,
  ventilacion: HeartPulse,
  "alimentacion-enteral": Stethoscope,
  "home-care": ShieldCheck,
};
---

<section class="py-12 bg-surface">
  <div class="container mx-auto px-6">
    <!-- Encabezado editable desde Keystatic -->
    <div class="text-center max-w-xl mx-auto mb-10">
      <h2
        data-aos="fade-up"
        data-aos-duration="500"
        class="text-2xl md:text-3xl font-bold text-theme mb-2 tracking-tight"
      >
        {serviciosData.tituloHome}
      </h2>
      <p
        data-aos="fade-up"
        data-aos-duration="500"
        data-aos-delay="100"
        class="text-xs sm:text-sm text-[var(--color-muted)] leading-relaxed"
      >
        {serviciosData.subtituloHome}
      </p>
    </div>

    <!-- Cards compactas -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        serviciosData.lista.map((s, i) => {
          const Icon = iconMap[s.id] || Wind;
          return (
            <a
              href={`/servicios/#${s.id}`}
              data-aos="fade-up"
              data-aos-duration="500"
              data-aos-delay={i * 80}
              class="p-5 bg-surface border border-gray-100 rounded-xl hover:shadow-md hover:border-[var(--color-accent)]/40 transition-all duration-300 flex flex-col justify-between group"
            >
              <div>
                <div class="w-9 h-9 rounded-lg bg-[var(--color-accent)]/10 text-[var(--color-accent)] flex items-center justify-center mb-3 group-hover:bg-[var(--color-accent)] group-hover:text-white transition-colors duration-300">
                  <Icon class="w-5 h-5" />
                </div>

                <h3 class="font-bold text-sm text-[var(--color-main)] mb-1 group-hover:text-[var(--color-accent)] transition-colors">
                  {s.title}
                </h3>

                <p class="text-xs text-[var(--color-muted)] leading-relaxed line-clamp-2">
                  {s.description}
                </p>
              </div>

              <div class="mt-4 pt-3 border-t border-gray-50 flex items-center justify-between text-[11px] font-bold text-[var(--color-accent)]">
                <span>Saber más</span>
                <ArrowUpRight class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
