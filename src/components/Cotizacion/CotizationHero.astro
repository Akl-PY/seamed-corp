---
import { slide } from "astro:transitions";
import { FileInput, X, FileText, Upload } from "lucide-astro";
---

<section id="cotizar" class="py-12 bg-surface">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-16 items-center overflow-hidden">

    <!-- Lado Izquierdo -->
    <div class="flex flex-col gap-6">
      <div
        data-aos="fade-down"
        data-aos-duration="500"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent/10 text-accent w-fit"
      >
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider">
          Cotización SeAMeD
        </span>
      </div>

      <h1
        data-aos="fade-up"
        data-aos-duration="500"
        class="text-5xl sm:text-6xl font-bold text-theme leading-tight"
      >
        Solicitá tu cotización
        <span class="tracking-tighter uppercase text-accent">HOY</span>
      </h1>

      <p
        data-aos="fade-up"
        data-aos-duration="500"
        data-aos-delay="200"
        class="text-xl text-muted leading-relaxed"
      >
        Nuestro equipo de expertos está listo para brindarte presupuesto de
        equipos o insumos en minutos. Podés adjuntar tu receta médica y los
        datos de tu obra social para agilizar tu trámite o reintegro.
      </p>
    </div>

    <!-- Formulario -->
    <div
      data-aos="fade-up"
      data-aos-duration="1000"
      data-aos-delay="600"
      class="bg-white p-8 md:p-10 rounded-2xl shadow-xl border border-main/10"
    >
      <h3 class="text-2xl font-bold text-theme mb-1">
        Presupuesto en Línea
      </h3>

      <p class="text-sm text-muted mb-6">
        Completá los datos y te responderemos a la brevedad.
      </p>

      <form class="grid gap-4">

        <!-- RECETA -->
        <div class="flex flex-col gap-2">
          <label class="text-xs font-semibold text-main/80">
            Receta o Prescripción Médica *
          </label>

          <div
            id="drop-zone"
            class="relative flex flex-col items-center justify-center w-full p-6 border-2 border-dashed border-main/20 rounded-xl bg-surface/50 hover:bg-surface hover:border-accent transition-all duration-200"
          >
            <!-- Estado Inicial: Subir archivo -->
            <div id="upload-prompt" class="flex flex-col items-center text-center pointer-events-none">
              <Upload class="w-8 h-8 mb-2 text-accent" />
              <p class="text-sm">
                <span class="font-semibold text-main">
                  Hacé clic para adjuntar
                </span>
                <br />
                o arrastrá tu archivo aquí
              </p>
              <p class="text-[11px] text-gray-400 mt-1">
                PDF, JPG o PNG (Máx. 5 MB)
              </p>
            </div>

            <!-- Estado Con Archivo Cargado -->
            <div
              id="file-uploaded"
              class="hidden items-center justify-between w-full p-3 rounded-lg bg-accent/10 text-accent font-medium text-sm transition-all z-10"
            >
              <div class="flex items-center gap-2 overflow-hidden pr-2">
                <FileText class="w-5 h-5 flex-shrink-0 text-accent" />
                <div class="flex flex-col min-w-0">
                  <span id="file-name" class="truncate text-main font-semibold text-xs"></span>
                  <span id="file-size" class="text-[10px] text-muted"></span>
                </div>
              </div>
              <button
                type="button"
                id="remove-file"
                class="p-1.5 rounded-full hover:bg-accent/20 text-main/60 hover:text-red-500 transition-colors z-20 cursor-pointer"
                title="Eliminar archivo"
              >
                <X class="w-4 h-4" />
              </button>
            </div>

            <!-- Input File Oculto pero Funcional -->
            <input
              id="receta"
              type="file"
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-0"
              accept=".pdf,image/png,image/jpeg,image/webp"
              required
            />
          </div>

          <!-- Mensaje de Error -->
          <p id="file-error" class="hidden text-xs font-semibold text-red-500 mt-1"></p>
        </div>

        <!-- OBRA SOCIAL -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input
            type="text"
            placeholder="Obra Social / Prepaga"
            class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm"
          />

          <input
            type="text"
            placeholder="Nº de Afiliado"
            class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm"
          />
        </div>

        <!-- NOMBRE -->
        <input
          type="text"
          placeholder="Nombre completo"
          class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm"
        />

        <!-- TELEFONO / EMAIL -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input
            type="tel"
            placeholder="Teléfono / WhatsApp"
            class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm"
          />

          <input
            type="email"
            placeholder="Correo electrónico"
            class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm"
          />
        </div>

        <!-- MENSAJE -->
        <textarea
          placeholder="¿Qué equipo o insumo estás buscando?"
          class="w-full border border-main/20 p-3 rounded-lg min-h-[90px] resize-none focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm"
        ></textarea>

        <button
          type="submit"
          class="w-full bg-accent text-white font-bold py-3.5 rounded-lg hover:brightness-110 transition-all shadow-lg shadow-accent/20 text-sm"
        >
          Solicitar Cotización
        </button>
      </form>
    </div>

    <div class="md:col-span-2 text-center pt-6 border-t border-main/10">
      <p class="text-sm text-muted">
        ¿Buscás comunicarte por otras consultas, soporte técnico o administración?

        <a
          href="/contacto"
          class="font-bold text-accent hover:underline inline-flex items-center gap-1"
        >
          Ir a medios de contacto →
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  function setupFileInput() {
    const input = document.getElementById("receta") as HTMLInputElement | null;
    const dropZone = document.getElementById("drop-zone");
    const uploadPrompt = document.getElementById("upload-prompt");
    const fileUploaded = document.getElementById("file-uploaded");
    const fileName = document.getElementById("file-name");
    const fileSize = document.getElementById("file-size");
    const removeBtn = document.getElementById("remove-file");
    const fileError = document.getElementById("file-error");

    if (!input || !dropZone) return;

    const MAX_SIZE_MB = 5;

    function formatBytes(bytes: number): string {
      if (bytes === 0) return "0 Bytes";
      const k = 1024;
      const sizes = ["Bytes", "KB", "MB"];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + " " + sizes[i];
    }

    function showError(msg: string) {
      if (fileError) {
        fileError.textContent = msg;
        fileError.classList.remove("hidden");
      }
    }

    function clearError() {
      if (fileError) {
        fileError.textContent = "";
        fileError.classList.add("hidden");
      }
    }

    function clearFile() {
      if (input) {
        input.value = "";
        input.classList.remove("pointer-events-none");
      }
      if (uploadPrompt) uploadPrompt.classList.remove("hidden");
      if (fileUploaded) {
        fileUploaded.classList.remove("flex");
        fileUploaded.classList.add("hidden");
      }
      clearError();
    }

    function handleFile(file: File) {
      clearError();

      // Validar peso máximo (5 MB)
      if (file.size > MAX_SIZE_MB * 1024 * 1024) {
        showError(`El archivo supera el límite de ${MAX_SIZE_MB} MB.`);
        clearFile();
        return;
      }

      if (fileName) fileName.textContent = file.name;
      if (fileSize) fileSize.textContent = formatBytes(file.size);

      if (uploadPrompt) uploadPrompt.classList.add("hidden");
      if (fileUploaded) {
        fileUploaded.classList.remove("hidden");
        fileUploaded.classList.add("flex");
      }
      
      // Ocultar interacción del input para no bloquear el botón de remover
      input?.classList.add("pointer-events-none");
    }

    // Listener para input tradicional
    input.addEventListener("change", () => {
      if (input.files && input.files[0]) {
        handleFile(input.files[0]);
      } else {
        clearFile();
      }
    });

    // Listener para remover archivo
    removeBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      clearFile();
    });

    // Prevenir comportamientos por defecto del navegador para Drag & Drop
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
      }, false);
    });

    // Feedback visual al arrastrar
    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, () => {
        dropZone.classList.add('border-accent', 'bg-accent/10');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, () => {
        dropZone.classList.remove('border-accent', 'bg-accent/10');
      }, false);
    });

    // Procesar el evento Drop
    dropZone.addEventListener('drop', (e: DragEvent) => {
      const dt = e.dataTransfer;
      const files = dt?.files;

      if (files && files.length > 0) {
        const file = files[0];

        // Crear una lista de archivos para asignar al input nativo
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        input.files = dataTransfer.files;

        handleFile(file);
      }
    });
  }

  // Inicializar script respetando View Transitions de Astro
  document.addEventListener("astro:page-load", setupFileInput);
  setupFileInput();
</script>