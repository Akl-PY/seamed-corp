---
import { slide } from "astro:transitions";
---

<section id="cotizar" class="py-12 bg-surface">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-16 items-center overflow-hidden">
    
    <!-- Lado Izquierdo: Textos Informativos -->
    <div class="flex flex-col gap-6">
      <h1 data-aos="fade-up" data-aos-duration="500" class="text-5xl md:text-6xl font-bold text-main leading-tight">
        Solicitá tu cotización <span class="tracking-tighter uppercase text-accent">HOY</span>
      </h1>
      <p data-aos="fade-up" data-aos-duration="500" data-aos-delay="200" class="text-xl text-muted leading-relaxed">
        Nuestro equipo de expertos está listo para brindarte presupuesto de equipos o insumos en minutos.
        Podés adjuntar tu receta médica y los datos de tu obra social para agilizar tu trámite o reintegro.
      </p>
    </div>

    <!-- Lado Derecho: Formulario de Cotización -->
    <div data-aos="fade-up" data-aos-duration="1000" data-aos-delay="600" class="bg-white p-8 md:p-10 rounded-2xl shadow-xl border border-main/10">
      <h3 class="text-2xl font-bold text-main mb-1">Presupuesto en Línea</h3>
      <p class="text-sm text-gray-500 mb-6">Completá los datos y te responderemos a la brevedad.</p>
      
      <form class="grid gap-4">
        <!-- Nombre Completo -->
        <input 
          type="text" 
          placeholder="Nombre completo *" 
          class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm" 
          required 
        />
        
        <!-- Teléfono y Email -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input 
            type="tel" 
            placeholder="Teléfono / WhatsApp *" 
            class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm" 
            required 
          />
          <input 
            type="email" 
            placeholder="Correo electrónico *" 
            class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm" 
            required 
          />
        </div>

        <!-- Obra Social y Nº Afiliado (Opcionales para Reintegros) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input 
            type="text" 
            placeholder="Obra Social / Prepaga (Opcional)" 
            class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm" 
          />
          <input 
            type="text" 
            placeholder="Nº de Afiliado (Opcional)" 
            class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm" 
          />
        </div>

        <!-- Adjuntar Receta Médica -->
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-main/80">Receta o Prescripción Médica (Opcional):</label>
          <div class="relative flex items-center justify-center w-full">
            <label class="flex flex-col items-center justify-center w-full h-24 border-2 border-dashed border-main/20 rounded-xl cursor-pointer bg-surface/50 hover:bg-surface hover:border-accent transition-all">
              <div class="flex flex-col items-center justify-center pt-3 pb-3">
                <svg class="w-6 h-6 mb-1 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 0115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                <p class="text-xs text-muted"><span class="font-bold text-main">Haz clic para adjuntar</span> o arrastra tu archivo</p>
                <p class="text-[10px] text-gray-400 mt-0.5">PDF, JPG o PNG (Máx. 5MB)</p>
              </div>
              <input type="file" class="hidden" accept=".pdf, image/*" />
            </label>
          </div>
        </div>
        
        <!-- Detalle de la consulta / mensaje -->
        <textarea 
          placeholder="¿Qué equipo o insumo estás buscando? (Opcional)..." 
          class="w-full border border-main/20 p-3 rounded-lg min-h-[90px] resize-none focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm"
        ></textarea>

        <!-- Aceptación Privacidad -->
        <label class="flex items-center gap-3 cursor-pointer group mt-1">
          <input type="checkbox" class="w-4 h-4 cursor-pointer accent-accent" required />
          <span class="text-xs text-main group-hover:text-accent transition-colors">Acepto la política de privacidad y tratamiento de datos</span>
        </label>

        <!-- Botón Solicitar Cotización -->
        <button type="submit" class="w-full bg-accent text-white font-bold py-3.5 rounded-lg hover:brightness-110 transition-all shadow-lg shadow-accent/20 text-sm mt-2">
          Solicitar Cotización
        </button>
      </form>
    </div>

    <!-- Redirección a Contacto General -->
    <div class="md:col-span-2 text-center pt-6 border-t border-main/10">
      <p class="text-sm text-muted">
        ¿Buscás comunicarte por otras consultas, soporte técnico o administración? 
        <a href="/contacto" class="font-bold text-accent hover:underline inline-flex items-center gap-1 transition-colors">
          Ir a medios de contacto →
        </a>
      </p>
    </div>

  </div>
</section>