---
import { X, FileText, Upload } from "lucide-astro";
import cotizacionData from "../../data/cotizacion.json";
---

<section id="cotizar" class="py-12 bg-surface">
  <div
    class="container mx-auto px-6 grid md:grid-cols-2 gap-12 lg:gap-16 items-center overflow-hidden"
  >
    <!-- Columna Izquierda: Textos Hero -->
    <div class="flex flex-col gap-6">
      <h1
        data-aos="fade-up"
        data-aos-duration="500"
        class="text-4xl sm:text-5xl md:text-6xl font-bold text-theme leading-tight tracking-tight"
      >
        {cotizacionData.heroTitulo}
        <span class="text-accent">{cotizacionData.heroTituloAcento}</span>
      </h1>

      <p
        data-aos="fade-up"
        data-aos-duration="500"
        data-aos-delay="200"
        class="text-xl md:text-2xl text-muted leading-relaxed font-medium"
      >
        {cotizacionData.heroBajada}
      </p>
    </div>

    <!-- Columna Derecha: Tarjeta de Formulario -->
    <div
      data-aos="fade-up"
      data-aos-duration="1000"
      data-aos-delay="600"
      class="bg-bg p-8 md:p-10 rounded-2xl shadow-xl border border-main/10"
    >
      <h3 class="text-2xl font-bold text-theme mb-1">
        {cotizacionData.formTitulo}
      </h3>

      <p class="text-sm text-muted mb-6">
        {cotizacionData.formSubtitulo}
      </p>

      <form id="cotizacion-form" class="flex flex-col gap-5">
        <!-- Zona de Carga de Archivo -->
        <div class="flex flex-col gap-2">
          <span
            class="text-[10px] text-accent font-semibold uppercase tracking-wider"
          >
            Obligatorio
          </span>

          <div
            id="drop-zone"
            class="relative flex flex-col items-center justify-center w-full p-6 border-2 border-dashed border-main/20 rounded-xl bg-surface/50 hover:bg-surface hover:border-accent transition-all duration-200"
          >
            <div
              id="upload-prompt"
              class="flex flex-col items-center text-center pointer-events-none"
            >
              <Upload class="w-8 h-8 mb-2 text-accent" />

              <p class="text-sm">
                <span class="font-semibold text-main">
                  Hacé clic para adjuntar tu pedido médico
                </span>
                <br />
                o arrastrá tu archivo aquí
              </p>

              <p class="text-[11px] text-gray-400 mt-1">
                PDF, JPG o PNG (Máx. 25 MB)
              </p>
            </div>

            <div
              id="file-uploaded"
              class="hidden grid-cols-[1fr_auto] items-center gap-2 w-full p-3 rounded-lg bg-accent/10 text-accent font-medium text-sm transition-all z-10"
            >
              <div
                class="flex flex-1 items-center gap-2 min-w-0 overflow-hidden"
              >
                <FileText class="w-5 h-5 shrink-0 text-accent" />

                <div class="flex-1 overflow-hidden">
                  <span
                    id="file-name"
                    class="block max-w-[80%] flex-1 truncate text-theme font-semibold text-xs"
                  ></span>

                  <span
                    id="file-size"
                    class="block w-fit text-[10px] text-muted"
                  ></span>
                </div>
              </div>

              <button
                type="button"
                id="remove-file"
                aria-label="Eliminar archivo"
                class="shrink-0 p-1.5 rounded-full hover:bg-accent/20 text-main/60 hover:text-red-500 transition-colors"
              >
                <X class="w-4 h-4" />
              </button>
            </div>

            <input
              id="receta"
              type="file"
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-0"
              accept=".pdf,image/png,image/jpeg,image/webp"
              required
            />
          </div>

          <p
            id="file-error"
            class="hidden text-xs font-semibold text-red-500 mt-1"
          ></p>
        </div>

        <!-- Campos: Obra Social y Afiliado -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <input
            type="text"
            placeholder="Obra Social / Prepaga (Opcional)"
            class="w-full border border-main/20 p-3.5 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm bg-bg"
          />

          <input
            type="text"
            placeholder="Nº de Afiliado (Opcional)"
            class="w-full border border-main/20 p-3.5 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm bg-bg"
          />
        </div>

        <!-- Campo: Nombre Completo -->
        <div>
          <input
            type="text"
            placeholder="Nombre completo (Opcional)"
            class="w-full border border-main/20 p-3.5 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm bg-bg"
          />
        </div>

        <!-- Campos: Teléfono y Correo -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <input
            type="tel"
            placeholder="Teléfono / WhatsApp (Opcional)"
            class="w-full border border-main/20 p-3.5 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm bg-bg"
          />

          <input
            type="email"
            placeholder="Correo electrónico (Opcional)"
            class="w-full border border-main/20 p-3.5 rounded-lg focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm bg-bg"
          />
        </div>

        <!-- Campo: Mensaje -->
        <div>
          <textarea
            placeholder="Tu mensaje / Asunto... (Opcional)"
            class="w-full border border-main/20 p-3.5 rounded-lg min-h-[100px] resize-none focus:ring-2 focus:ring-accent/50 outline-none transition-all text-sm bg-bg"
          ></textarea>
        </div>

        <!-- Botón de Envío -->
        <button
          id="submit-form"
          type="submit"
          class="w-full bg-accent text-bg font-bold py-3.5 rounded-lg hover:brightness-110 transition-all shadow-lg shadow-accent/20 text-sm mt-1 active:scale-[0.99]"
        >
          {cotizacionData.formBotonTexto}
        </button>
      </form>
    </div>
  </div>

  <div class="md:col-span-2 text-center pt-8 mt-6 border-t border-main/10">
    <p class="text-sm text-muted">
      {cotizacionData.footerTexto}
      <a
        href="/contacto"
        class="font-bold text-accent hover:underline inline-flex items-center gap-1 ml-1"
      >
        {cotizacionData.footerLinkTexto}
      </a>
    </p>
  </div>
</section>

<!-- =========================================================
     TOAST
     ========================================================= -->

<div
  id="toast-container"
  class="fixed inset-x-0 top-0 z-[99999] pointer-events-none flex justify-center px-3 pt-3 sm:px-4 sm:pt-5"
  aria-live="polite"
  aria-atomic="true"
></div>

<style>
  /*
   * El contenedor no necesita fondo.
   * El fondo pertenece al toast.
   */
  #toast-container {
    isolation: isolate;
  }

  .toast {
    width: min(100%, 440px);

    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;

    /*
     * IMPORTANTE:
     * El color viene del theme de Tailwind:
     * --color-bg -> bg-bg
     */
    background-color: var(--color-bg);

    border: 1px solid
      color-mix(
        in srgb,
        var(--color-main) 20%,
        transparent
      );

    border-radius: 16px;

    box-shadow:
      0 20px 45px color-mix(
        in srgb,
        var(--color-theme) 16%,
        transparent
      ),
      0 6px 18px color-mix(
        in srgb,
        var(--color-theme) 8%,
        transparent
      );

    padding: 13px 13px 16px;

    position: relative;
    overflow: hidden;

    pointer-events: auto;

    opacity: 0;

    transform: translateY(-24px) scale(0.97);

    animation:
      toast-enter 0.4s
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
  }

  .toast.is-leaving {
    animation:
      toast-leave 0.28s
      cubic-bezier(0.4, 0, 1, 1)
      forwards;
  }

  .toast-icon {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 12px;

    /*
     * Usa el color accent del theme.
     */
    background-color: color-mix(
      in srgb,
      var(--color-accent) 12%,
      var(--color-bg)
    );

    color: var(--color-accent);
  }

  .toast-icon svg {
    width: 21px;
    height: 21px;
  }

  .toast-content {
    min-width: 0;
  }

  .toast-title {
    margin: 0;

    color: var(--color-theme);

    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;
  }

  .toast-message {
    margin: 3px 0 0;

    color: var(--color-muted);

    font-size: 12px;
    line-height: 1.45;
  }

  .toast-close {
    width: 31px;
    height: 31px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    padding: 0;

    border: 0;
    border-radius: 8px;

    background: transparent;

    color: var(--color-muted);

    cursor: pointer;

    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .toast-close:hover {
    background-color: var(--color-surface);
    color: var(--color-theme);
  }

  .toast-close:active {
    transform: scale(0.9);
  }

  .toast-close svg {
    width: 17px;
    height: 17px;
  }

  .toast-progress {
    position: absolute;

    left: 0;
    bottom: 0;

    width: 100%;
    height: 3px;

    background-color: var(--color-accent);

    transform-origin: left;

    animation:
      toast-progress
      var(--toast-duration)
      linear forwards;
  }

  /*
   * SUCCESS
   *
   * No usamos verde:
   * mantenemos el branding SeAMeD.
   */
  .toast-success .toast-icon {
    background-color: color-mix(
      in srgb,
      var(--color-accent) 12%,
      var(--color-bg)
    );

    color: var(--color-accent);
  }

  /*
   * ERROR / WARNING
   *
   * Mantienen el sistema visual del sitio.
   */
  .toast-error .toast-icon,
  .toast-warning .toast-icon {
    background-color: color-mix(
      in srgb,
      var(--color-theme) 8%,
      var(--color-bg)
    );

    color: var(--color-theme);
  }

  .toast-error .toast-progress,
  .toast-warning .toast-progress {
    background-color: var(--color-main);
  }

  @keyframes toast-enter {
    0% {
      opacity: 0;
      transform: translateY(-24px) scale(0.97);
    }

    60% {
      opacity: 1;
      transform: translateY(2px) scale(1.005);
    }

    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes toast-leave {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    100% {
      opacity: 0;
      transform: translateY(-18px) scale(0.97);
    }
  }

  @keyframes toast-progress {
    from {
      transform: scaleX(1);
    }

    to {
      transform: scaleX(0);
    }
  }

  @media (max-width: 640px) {
    #toast-container {
      padding-top: 12px;
    }

    .toast {
      width: 100%;
      max-width: 440px;

      gap: 10px;

      padding: 12px 11px 15px;

      border-radius: 15px;
    }

    .toast-icon {
      width: 38px;
      height: 38px;

      border-radius: 11px;
    }

    .toast-icon svg {
      width: 19px;
      height: 19px;
    }

    .toast-title {
      font-size: 13px;
    }

    .toast-message {
      font-size: 11.5px;
    }

    .toast-close {
      width: 30px;
      height: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast,
    .toast.is-leaving {
      animation: none;
      transform: none;
    }

    .toast-progress {
      animation: none;
    }
  }
</style>

<script>
  type ToastType =
    | "success"
    | "error"
    | "warning";

  function showToast(
    title: string,
    message: string,
    type: ToastType = "success",
    duration = 5000,
  ) {
    const container =
      document.getElementById(
        "toast-container",
      );

    if (!container) return;

    const currentToast =
      container.querySelector(
        ".toast:not(.is-leaving)",
      );

    if (currentToast) {
      currentToast.classList.add(
        "is-leaving",
      );

      setTimeout(() => {
        currentToast.remove();
      }, 280);
    }

    const icons = {
      success: `
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      `,

      error: `
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m15 9-6 6"></path>
          <path d="m9 9 6 6"></path>
        </svg>
      `,

      warning: `
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
          <path d="M12 9v4"></path>
          <path d="M12 17h.01"></path>
        </svg>
      `,
    };

    const toast =
      document.createElement("div");

    toast.className =
      `toast toast-${type}`;

    toast.setAttribute(
      "role",
      type === "error"
        ? "alert"
        : "status",
    );

    toast.style.setProperty(
      "--toast-duration",
      `${duration}ms`,
    );

    toast.innerHTML = `
      <div class="toast-icon">
        ${icons[type]}
      </div>

      <div class="toast-content">
        <p class="toast-title">
          ${title}
        </p>

        <p class="toast-message">
          ${message}
        </p>
      </div>

      <button
        type="button"
        class="toast-close"
        aria-label="Cerrar notificación"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>

      <div class="toast-progress"></div>
    `;

    container.appendChild(toast);

    let removed = false;

    let timeout:
      ReturnType<typeof setTimeout> | null =
        null;

    function removeToast() {
      if (removed) return;

      removed = true;

      if (timeout) {
        clearTimeout(timeout);
      }

      toast.classList.add(
        "is-leaving",
      );

      setTimeout(() => {
        toast.remove();
      }, 280);
    }

    toast
      .querySelector(".toast-close")
      ?.addEventListener(
        "click",
        removeToast,
      );

    timeout = setTimeout(
      removeToast,
      duration,
    );
  }

  function setupCotizacion() {
    const input =
      document.getElementById(
        "receta",
      ) as HTMLInputElement | null;

    const dropZone =
      document.getElementById(
        "drop-zone",
      );

    const uploadPrompt =
      document.getElementById(
        "upload-prompt",
      );

    const fileUploaded =
      document.getElementById(
        "file-uploaded",
      );

    const fileName =
      document.getElementById(
        "file-name",
      );

    const fileSize =
      document.getElementById(
        "file-size",
      );

    const removeBtn =
      document.getElementById(
        "remove-file",
      );

    const fileError =
      document.getElementById(
        "file-error",
      );

    const form =
      document.getElementById(
        "cotizacion-form",
      ) as HTMLFormElement | null;

    if (
      !input ||
      !dropZone ||
      !form
    ) {
      return;
    }

    if (
      form.dataset.initialized ===
      "true"
    ) {
      return;
    }

    form.dataset.initialized =
      "true";

    const MAX_SIZE_MB = 25;

    function formatBytes(
      bytes: number,
    ): string {
      if (bytes === 0) {
        return "0 Bytes";
      }

      const k = 1024;

      const sizes = [
        "Bytes",
        "KB",
        "MB",
      ];

      const i = Math.floor(
        Math.log(bytes) /
          Math.log(k),
      );

      return (
        parseFloat(
          (
            bytes /
            Math.pow(k, i)
          ).toFixed(2),
        ) +
        " " +
        sizes[i]
      );
    }

    function showError(
      message: string,
    ) {
      if (!fileError) return;

      fileError.textContent =
        message;

      fileError.classList.remove(
        "hidden",
      );
    }

    function clearError() {
      if (!fileError) return;

      fileError.textContent = "";

      fileError.classList.add(
        "hidden",
      );
    }

    function clearFile() {
      input.value = "";

      input.classList.remove(
        "pointer-events-none",
      );

      uploadPrompt?.classList.remove(
        "hidden",
      );

      if (fileUploaded) {
        fileUploaded.classList.remove(
          "grid",
        );

        fileUploaded.classList.add(
          "hidden",
        );
      }

      clearError();
    }

    function handleFile(
      file: File,
    ) {
      clearError();

      if (
        file.size >
        MAX_SIZE_MB *
          1024 *
          1024
      ) {
        showError(
          `El archivo supera el límite de ${MAX_SIZE_MB} MB.`,
        );

        clearFile();

        showToast(
          "Archivo demasiado grande",
          `El archivo no puede superar los ${MAX_SIZE_MB} MB.`,
          "error",
        );

        return;
      }

      if (fileName) {
        fileName.textContent =
          file.name;
      }

      if (fileSize) {
        fileSize.textContent =
          formatBytes(
            file.size,
          );
      }

      uploadPrompt?.classList.add(
        "hidden",
      );

      if (fileUploaded) {
        fileUploaded.classList.remove(
          "hidden",
        );

        fileUploaded.classList.add(
          "grid",
        );
      }

      input.classList.add(
        "pointer-events-none",
      );
    }

    input.addEventListener(
      "change",
      () => {
        if (
          input.files?.[0]
        ) {
          handleFile(
            input.files[0],
          );
        } else {
          clearFile();
        }
      },
    );

    removeBtn?.addEventListener(
      "click",
      (event) => {
        event.preventDefault();
        event.stopPropagation();

        clearFile();
      },
    );

    [
      "dragenter",
      "dragover",
      "dragleave",
      "drop",
    ].forEach(
      (eventName) => {
        dropZone.addEventListener(
          eventName,
          (event) => {
            event.preventDefault();
            event.stopPropagation();
          },
          false,
        );
      },
    );

    [
      "dragenter",
      "dragover",
    ].forEach(
      (eventName) => {
        dropZone.addEventListener(
          eventName,
          () => {
            dropZone.classList.add(
              "border-accent",
              "bg-accent/10",
            );
          },
          false,
        );
      },
    );

    [
      "dragleave",
      "drop",
    ].forEach(
      (eventName) => {
        dropZone.addEventListener(
          eventName,
          () => {
            dropZone.classList.remove(
              "border-accent",
              "bg-accent/10",
            );
          },
          false,
        );
      },
    );

    dropZone.addEventListener(
      "drop",
      (event: DragEvent) => {
        const files =
          event.dataTransfer
            ?.files;

        if (
          !files ||
          files.length === 0
        ) {
          return;
        }

        const file = files[0];

        const dataTransfer =
          new DataTransfer();

        dataTransfer.items.add(
          file,
        );

        input.files =
          dataTransfer.files;

        handleFile(file);
      },
    );

    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();

        if (
          !input.files?.[0]
        ) {
          showToast(
            "Falta adjuntar el pedido médico",
            "Seleccioná el archivo antes de enviar la solicitud.",
            "warning",
          );

          return;
        }

        const submitButton =
          document.getElementById(
            "submit-form",
          ) as HTMLButtonElement | null;

        if (submitButton) {
          submitButton.disabled =
            true;

          submitButton.classList.add(
            "opacity-70",
            "cursor-not-allowed",
          );
        }

        /*
         * Acá simulamos el envío.
         * Reemplazá este bloque por tu fetch/API
         * cuando conectes el backend.
         */
        setTimeout(() => {
          showToast(
            "Solicitud enviada",
            "Nos contactaremos con vos a la brevedad.",
            "success",
            5000,
          );

          form.reset();

          clearFile();

          if (submitButton) {
            submitButton.disabled =
              false;

            submitButton.classList.remove(
              "opacity-70",
              "cursor-not-allowed",
            );
          }
        }, 500);
      },
    );
  }

  document.addEventListener(
    "astro:page-load",
    setupCotizacion,
  );

  setupCotizacion();
</script>