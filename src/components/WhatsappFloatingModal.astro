---
import wppData from "../data/global/whatsapp.json";

// Mapeo seguro de SVG según el tipo de icono elegido en Keystatic
const iconPaths: Record<string, string> = {
  cart: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z",
  box: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
  support:
    "M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z",
};
---

<!-- 1. BOTÓN FLOTANTE (Fixed) -->
<div class="fixed bottom-6 right-6 z-50">
  <button
    id="wppFabBtn"
    type="button"
    aria-label="Abrir opciones de WhatsApp"
    class="group relative flex items-center justify-center w-14 h-14 bg-[#25D366] text-white rounded-full shadow-2xl hover:scale-110 active:scale-95 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-[#25D366]/40 cursor-pointer"
  >
    <!-- Ping de atención pulse -->
    <span class="absolute top-0 right-0 flex h-4 w-4">
      <span
        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-75"
      ></span>
      <span
        class="relative inline-flex rounded-full h-4 w-4 bg-white border-2 border-[#25D366]"
      ></span>
    </span>

    <!-- Icono de WhatsApp -->
    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
      <path
        d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
      ></path>
    </svg>
  </button>
</div>

<!-- MODAL POPUP -->
<div
  id="wppModalBackdrop"
  class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 flex items-end sm:items-center justify-center p-0 sm:p-4"
>
  <div
    id="wppModalContent"
    class="w-full max-w-2xl bg-bg border border-brand-gray/15 rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden transform translate-y-full sm:translate-y-8 transition-transform duration-300 ease-out"
  >
    <div class="grid grid-cols-1 md:grid-cols-5">
      <!-- Panel Lateral Izquierdo -->
      <div
        class="md:col-span-2 bg-surface p-6 flex flex-col justify-between border-b md:border-b-0 md:border-r border-brand-gray/15 relative"
      >
        <button
          id="closeWppModalMobile"
          class="md:hidden absolute top-4 right-4 text-muted hover:text-main p-2"
          aria-label="Cerrar modal"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <div>
          <div
            class="w-12 h-12 rounded-2xl bg-[#25D366]/10 text-[#25D366] flex items-center justify-center mb-4"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path
                d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-theme leading-tight">
            {wppData.modalTitulo}
          </h3>
          <p class="text-xs text-muted mt-2 leading-relaxed">
            {wppData.modalSubtitulo}
          </p>
        </div>

        <div class="block md:pt-6 pt-2 md:border-t border-brand-gray/10">
          <p class="text-[11px] text-muted font-medium">
            ⚡ Horario de atención online: <span class="text-main font-semibold"
              >{wppData.horarioAtencion}</span
            >
          </p>
        </div>
      </div>

      <!-- Panel Derecho (Opciones dinámicas) -->
      <div
        class="md:col-span-3 p-6 bg-bg flex flex-col justify-between relative"
      >
        <button
          id="closeWppModalDesktop"
          class="hidden md:flex absolute top-4 right-4 text-muted hover:text-main p-1.5 rounded-lg hover:bg-surface transition-colors"
          aria-label="Cerrar modal"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <span
          class="text-[11px] font-bold uppercase tracking-wider text-accent mb-3 inline-block"
        >
          Elegí tu canal de atención
        </span>

        <div class="space-y-3 my-auto">
          {
            wppData.opciones?.map((opt) => {
              const pathData = iconPaths[opt.iconType] || iconPaths.cart;
              const linkUrl = `https://wa.me/${opt.phoneNumber}/?text=${encodeURIComponent(opt.defaultText)}`;

              return (
                <a
                  href={linkUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-start gap-3.5 p-3.5 rounded-2xl border border-brand-gray/15 hover:border-[#25D366] hover:bg-[#25D366]/5 transition-all duration-200"
                >
                  <div class="w-10 h-10 rounded-xl bg-surface border border-brand-gray/10 text-accent group-hover:bg-[#25D366] group-hover:text-white flex items-center justify-center shrink-0 transition-colors duration-200">
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.8"
                        d={pathData}
                      />
                    </svg>
                  </div>

                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2">
                      <h4 class="text-sm font-bold text-main group-hover:text-[#25D366] transition-colors truncate">
                        {opt.title}
                      </h4>
                      <span class="text-[10px] font-semibold text-accent bg-theme/10 px-2 py-0.5 rounded-full shrink-0">
                        {opt.badge}
                      </span>
                    </div>
                    <p class="text-xs text-muted mt-0.5 line-clamp-1">
                      {opt.description}
                    </p>
                  </div>
                </a>
              );
            })
          }
        </div>

        <p class="text-[10px] text-center text-muted mt-4">
          Al hacer clic se abrirá la aplicación oficial de WhatsApp.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function initWhatsappModal() {
    const fabBtn = document.getElementById("wppFabBtn");
    const backdrop = document.getElementById("wppModalBackdrop");
    const content = document.getElementById("wppModalContent");
    const closeBtnMobile = document.getElementById("closeWppModalMobile");
    const closeBtnDesktop = document.getElementById("closeWppModalDesktop");

    if (!fabBtn || !backdrop || !content) return;

    const openModal = () => {
      backdrop.classList.remove("opacity-0", "pointer-events-none");
      backdrop.classList.add("opacity-100");
      content.classList.remove("translate-y-full", "sm:translate-y-8");
      content.classList.add("translate-y-0");
      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      backdrop.classList.remove("opacity-100");
      backdrop.classList.add("opacity-0", "pointer-events-none");
      content.classList.remove("translate-y-0");
      content.classList.add("translate-y-full", "sm:translate-y-8");
      document.body.style.overflow = "";
    };

    fabBtn.addEventListener("click", openModal);
    closeBtnMobile?.addEventListener("click", closeModal);
    closeBtnDesktop?.addEventListener("click", closeModal);

    backdrop.addEventListener("click", (e) => {
      if (e.target === backdrop) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !backdrop.classList.contains("opacity-0")) {
        closeModal();
      }
    });
  }

  document.addEventListener("astro:page-load", initWhatsappModal);
</script>
