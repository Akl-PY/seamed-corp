---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-main)] text-white pt-16 pb-8">
  <div class="container mx-auto px-6">
    <div class="grid md:grid-cols-4 gap-12 mb-16">
      
      <!-- Brand & NAP -->
      <div class="flex flex-col gap-4">
        <h3 class="text-xl font-bold text-[var(--color-theme)]">SeAMeD S.A.</h3>
        <address class="not-italic text-[var(--color-brand-gray)] text-sm">
          Alta Gracia, Córdoba<br>
          Argentina
        </address>
        <a href="tel:+54..." class="text-white hover:text-[var(--color-theme)] transition-colors">
          +54 3547 XXX XXX
        </a>
      </div>

      <!-- Silos de Navegación -->
      <div>
        <h4 class="font-bold mb-4 uppercase tracking-wider text-xs">Catálogo</h4>
        <ul class="flex flex-col gap-2 text-[var(--color-brand-gray)] text-sm">
          <li><a href="/catalogo/oxigenoterapia" class="hover:text-white">Oxigenoterapia</a></li>
          <li><a href="/catalogo/respiratorios" class="hover:text-white">Ventilación Mecánica</a></li>
          <li><a href="/catalogo/insumos" class="hover:text-white">Insumos Médicos</a></li>
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <h4 class="font-bold mb-4 uppercase tracking-wider text-xs">Empresa</h4>
        <ul class="flex flex-col gap-2 text-[var(--color-brand-gray)] text-sm">
          <li><a href="/sobre-nosotros" class="hover:text-white">Quiénes somos</a></li>
          <li><a href="/contacto" class="hover:text-white">Contacto</a></li>
          <li><a href="/politica-privacidad" class="hover:text-white">Privacidad</a></li>
        </ul>
      </div>

      <!-- CTA Rápido -->
      <div class="flex flex-col gap-4">
        <h4 class="font-bold uppercase tracking-wider text-xs">Atención al Paciente</h4>
        <p class="text-xs text-[var(--color-brand-gray)]">Soporte técnico y asesoramiento profesional las 24hs.</p>
        <a href="/contacto" class="bg-[var(--color-theme)] text-white text-center py-2 rounded text-sm font-bold hover:bg-[var(--color-accent)] transition-all">
          Solicitar Asesoramiento
        </a>
      </div>
    </div>

    <!-- Crédito Técnico -->
    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-[var(--color-brand-gray)]">
      <p>© {currentYear} SeAMeD S.A. Todos los derechos reservados.</p>
      <p>Desarrollo técnico por <a href="https://aim.com.ar" class="hover:text-white transition-colors">AIM - PROGRAMACION</a></p>
    </div>
  </div>
</footer>