---
import { Image } from "astro:assets";
import SeamedLogo from "../assets/seamed.png";
// Si tenés el SITE_CONFIG descentralizado, lo podés usar para las URLs dinámicas.
// import { SITE_CONFIG } from '../../config/site';
---

<header class="sticky top-0 z-50 w-full border-b border-brand-gray/15 bg-bg/90 backdrop-blur-md transition-all duration-300">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    
    <div class="flex lg:flex-1">
      <a href="/" class="-m-1.5 p-1.5 focus-visible:outline-2 focus-visible:outline-theme" aria-label="SeAMeD S.A. - Volver al inicio">
        <Image 
          class="h-10 w-auto object-contain" 
          src={SeamedLogo}
          alt="Logotipo de SeAMeD S.A. Equipamiento e Insumos Médicos" 
          width="250" 
          height="40"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </div>

    <button 
  type="button" 
  id="mobile-menu-btn"
  class="group md:hidden -m-2.5 p-2.5 rounded-md text-main focus-visible:outline-2 focus-visible:outline-theme"
  aria-controls="mobile-menu"
  aria-expanded="false"
>
  <div class="relative w-6 h-6 flex items-center justify-center">
    
    <div class="absolute inset-0 transition-all duration-300 ease-in-out group-aria-expanded:opacity-0 group-aria-expanded:rotate-90">
      <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
      </svg>
    </div>

    <div class="absolute inset-0 transition-all duration-300 ease-in-out opacity-0 group-aria-expanded:opacity-100 group-aria-expanded:-rotate-90">
      <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </div>
    
  </div>
</button>

    <nav class="hidden md:flex md:gap-x-10" aria-label="Navegación principal desktop">
      <a href="#equipamiento" class="text-sm font-semibold tracking-wide text-main hover:text-theme transition-colors duration-200">Equipamiento</a>
      <a href="#insumos" class="text-sm font-semibold tracking-wide text-main hover:text-theme transition-colors duration-200">Insumos</a>
      <a href="/nosotros" class="text-sm font-semibold tracking-wide text-main hover:text-theme transition-colors duration-200">Nosotros</a>
      <a href="/certificaciones" class="text-sm font-semibold tracking-wide text-main hover:text-theme transition-colors duration-200">Garantía y Calidad</a>
    </nav>

    <div class="hidden md:flex md:flex-1 md:justify-end">
      <a 
        href="/contacto" 
        class="inline-flex items-center justify-center rounded-lg bg-theme px-5 py-2.5 text-sm font-bold text-main shadow-xs hover:bg-accent transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-theme"
      >
        Cotizar Equipamiento
      </a>
    </div>
  </div>

<div id="mobile-menu" class="hidden overflow-hidden transition-all duration-500 ease-in-out border-t border-brand-gray/10 bg-bg px-4 shadow-xl">
  <div class="space-y-4 py-6">
    <a href="#equipamiento" class="mobile-link block rounded-lg px-3 py-2 text-base font-medium text-main hover:bg-surface">Equipamiento</a>
    <a href="#insumos" class="mobile-link block rounded-lg px-3 py-2 text-base font-medium text-main hover:bg-surface">Insumos</a>
    <a href="#nosotros" class="mobile-link block rounded-lg px-3 py-2 text-base font-medium text-main hover:bg-surface">Nosotros</a>
    <a href="#certificaciones" class="mobile-link block rounded-lg px-3 py-2 text-base font-medium text-main hover:bg-surface">Garantía y Calidad</a>
    <a href="#contacto" class="mobile-link block text-center rounded-lg bg-theme px-3 py-3 text-base font-bold text-main">Cotizar Equipamiento</a>
  </div>
</div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  if(!menuBtn || !mobileMenu) {
    console.warn('Elementos del menú móvil no encontrados. Verificar IDs en el HTML.');
  } else {
  // Inicializar estado de altura para la transición
  mobileMenu.style.maxHeight = "0px";

  function toggleMenu() {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    const newState = !isExpanded;

    // 1. Cambiar estado de accesibilidad
    menuBtn?.setAttribute('aria-expanded', newState.toString());

    // 2. Lógica de animación
    if (newState) {
      mobileMenu!.classList.remove('hidden');
      // Usamos requestAnimationFrame para asegurar que el navegador detecte el cambio de display
      requestAnimationFrame(() => {
        mobileMenu!.style.maxHeight = mobileMenu!.scrollHeight + "px";
        mobileMenu!.style.opacity = "1";
      });
    } else {
      mobileMenu!.style.maxHeight = "0px";
      mobileMenu!.style.opacity = "0";
      // Ocultar tras terminar la animación (500ms = duración CSS)
      setTimeout(() => mobileMenu!.classList.add('hidden'), 500);
    }

    // 3. Alternar iconos (basado en tu estructura original)
    const openIcon = document.getElementById('open');
    const closedIcon = document.getElementById('closed');
    openIcon?.classList.toggle('hidden');
    closedIcon?.classList.toggle('hidden');
  }
  
  menuBtn?.addEventListener('click', toggleMenu);

  // Cerrar al hacer clic en enlaces
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (menuBtn?.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
      }
    });
  });
}
</script>