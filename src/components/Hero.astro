---
// Hero.astro - Estructura optimizada para SEO y Core Web Vital
import { Image } from "astro:assets";
import Slide1 from "../assets/slide1.jpeg";
import Slide2 from "../assets/slide2.jpeg";

const carrouselItems = [
  // ... tus items anteriores
  {
    title: "Oxigenoterapia Domiciliaria 24/7",
    description: "Soporte técnico especializado y entrega programada de concentradores de oxígeno. Garantizamos autonomía y seguridad en el hogar.",
    image: Slide1,
    alt: "Servicio de oxigenoterapia domiciliaria en Córdoba por SeAMeD",
    button: "Cotizar Equipamiento"
  },
  {
    title: "Ventilación Mecánica No Invasiva",
    description: "Alquiler de equipos CPAP y BIPAP de última generación. Ajuste profesional y seguimiento técnico continuo para pacientes crónicos.",
    image: Slide2,
    alt: "Alquiler de equipos CPAP y BIPAP para ventilación no invasiva",
    button: "Solicitar Asesoramiento"
  },
  {
    title: "Certificación y Calidad Técnica",
    description: "Todo nuestro parque de equipos cuenta con mantenimiento preventivo riguroso y normas de bioseguridad. Tu salud es nuestra prioridad.",
    image: Slide2,
    alt: "Mantenimiento técnico de equipos médicos SeAMeD S.A.",
    button: "Conocer Más"
  }
];

const fade = {
  down : "fade-down",
  up: "fade-up",
  left: "fade-left",
  right: "fade-right",
}

---

<section  class="relative w-full h-[85vh] overflow-hidden bg-gray-900">
  <div id="carousel-track" class="relative w-full h-full">
    {carrouselItems.map((item, index) => (
      <div 
        class={`absolute inset-0 w-full h-full ${index=== 0 ? "z-10" : "z-0"}  transition-all duration-1000 ease-in-out ${index === 0 ? 'opacity-100 scale-100' : 'opacity-0 scale-100'}`}
      >
          <Image 
          class="h-full w-full object-cover" 
          src={item.image}
          alt={item.alt}
          loading="eager"
          fetchpriority="high"
        />
        
        <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/50 to-transparent"></div>

        <div class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center text-white z-10">
          <div data-aos={fade.up} class="max-w-3xl space-y-6">
            {index === 0 
              ? <h1 data-aos={fade.up} data-aos-duration="400" class="text-4xl md:text-6xl text-shadow font-extrabold tracking-tight uppercase drop-shadow-lg">{item.title}</h1>
              : <h2 data-aos={fade.up} data-aos-duration="400" class="text-4xl md:text-6xl text-shadow font-extrabold tracking-tight uppercase drop-shadow-lg">{item.title}</h2>
            }
            <p data-aos={fade.up} data-aos-duration="500" data-aos-delay="300" class="text-lg md:text-2xl mx-auto w-[80%] text-bg  font-medium leading-relaxed drop-shadow-md">
              {item.description}
            </p>
            <button data-aos={fade.up} data-aos-duration="800" data-aos-delay="500" class="mt-4 px-8 py-2 cursor-pointer bg-theme rounded-2xl hover:bg-white hover:text-theme text-white font-bold  transition-all duration-300 shadow-xl transform hover:-translate-y-1">
              {item.button}
            </button>
          </div>
        </div>

        <div data-aos={fade.up} data-aos-duration="800" data-aos-delay="1400" class="absolute inset-x-4 top-1/2 flex -translate-y-1/2 justify-between px-2 z-20">
          <button data-direction="prev" class="carousel-btn bg-white/10 hover:bg-white/30 backdrop-blur-md text-white p-2 md:p-4 rounded-full transition-all border border-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button data-direction="next" class="carousel-btn bg-white/10 hover:bg-white/30 backdrop-blur-md text-white p-2 md:p-4 rounded-full transition-all border border-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    ))}
  </div>
</section>
<script>
  let currentIndex = 0;
  const slides = document.querySelectorAll('#carousel-track > div');
  const totalSlides = slides.length;
  let interval :any

  function updateCarousel() {
    slides.forEach((slide, i) => {
      if (i === currentIndex) {
        slide.classList.remove('opacity-0');
        slide.classList.add('opacity-100');
        slide.classList.add('z-10')
      } else {
        slide.classList.remove('opacity-100');
        slide.classList.add('opacity-0');
        slide.classList.remove('z-10')
      }
    });
  }

  // Función para iniciar el auto-play
  function startAutoPlay() {
    interval = setInterval(() => {
      currentIndex = (currentIndex + 1) % totalSlides;
      updateCarousel();
    }, 5000);
  }

  // Función para resetear el timer
  function resetInterval() {
    clearInterval(interval); // Detenemos el actual
    startAutoPlay();         // Creamos uno nuevo desde cero
  }

function handleNavigation(direction: 'next' | 'prev') {
    if (direction === 'next') {
      currentIndex = (currentIndex + 1) % totalSlides;
    } else {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
    }
    updateCarousel();
    resetInterval();
  }

document.querySelectorAll('.carousel-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const dir = e.currentTarget!.getAttribute('data-direction');
      handleNavigation(dir);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      handleNavigation('next');
    } else if (e.key === 'ArrowLeft') {
      handleNavigation('prev');
    }
  });

  // Iniciamos por primera vez al cargar
  startAutoPlay();
</script>