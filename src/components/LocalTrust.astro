---
import { SITE_CONFIG } from "../config/site";

// LocalTrust.astro
// Integración de Local SEO con carga diferida de Google Maps/Reviews.
const MAP_URL = "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6810.716027764946!2d-64.2222637!3d-31.4042608!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9432a2a6e80f294d%3A0x527eaa34ded1a60f!2sSeAMeD%20S.A.!5e0!3m2!1ses-419!2sar!4v1780420464893!5m2!1ses-419!2sar";
---

<section class="py-20 bg-surface" id="ubicacion">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
    
    <!-- Bloque de Info Local -->
    <div class="flex flex-col gap-6">
      <h2 class="text-3xl font-bold text-main">
        Estamos en {["Córdoba","Argentina","Dean Funes 2870","Todo el País"].map((line, i)=>(<span class={`text-theme ms-2 font-bold absolute opacity-0 transition-all duration-600 uppercase tracking-tighter ${i == 0 && "opacity-100!"} `} data-class="line" data-position={i}>{line}</span>))}
      </h2>
      <p class="text-muted leading-relaxed">
        Atención personalizada en nuestro showroom y soporte técnico para toda la provincia de Córdoba. 
        Coordiná tu visita o solicita asistencia inmediata.
      </p>
      
      <div class="flex flex-col gap-4">
        <address class="not-italic text-main font-semibold">
          📍 Dirección: {SITE_CONFIG.organization.address?.streetAddress}, Córdoba.
        </address>
        <a href="tel:{SITE_CONFIG.organization.contactPoint?.telephone}" class="text-[var(--color-theme)] font-bold hover:underline">
          📞 {SITE_CONFIG.organization.contactPoint?.telephone}
        </a>
      </div>
      
      <a href={SITE_CONFIG.social.googleMaps} class="inline-block px-8 py-4 bg-[var(--color-main)] text-white font-bold rounded-lg hover:bg-black transition-all w-fit">
        Cómo llegar (Google Maps)
      </a>
    </div>

    <!-- Bloque de Mapa Diferido (Placeholder para CLS 0) -->
    <div class="relative w-full h-[400px] rounded-2xl overflow-hidden shadow-xl bg-gray-200" id="map-container">
      <iframe
        data-src={MAP_URL}
        class="w-full h-full z-20 border-0 opacity-0 transition-opacity duration-700"
        loading="lazy"
        title="Ubicación de SeAMeD S.A. en Google Maps"
        onload="this.style.opacity='1'"
      ></iframe>
    </div>
  </div>
</section>

<script>
    const lines = document.querySelectorAll('[data-class="line"]');
    let currentLine = 0;
    setInterval(() => {
      lines.forEach(line => line.classList.remove('opacity-100!'));
      currentLine = (currentLine + 1) % lines.length;
      lines[currentLine].classList.add('opacity-100!');
    }, 3000);
    const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const iframe = entry.target.querySelector('iframe');
        if (iframe && !iframe.src) {
          iframe.src = iframe.dataset.src || '';
        }
      }
    });
  });
  observer.observe(document.getElementById('map-container')!);
</script>