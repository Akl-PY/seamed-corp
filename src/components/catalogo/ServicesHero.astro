      </span> -->
      <h1 data-aos="fade-up" data-aos-duration="500" class="text-4xl md:text-5xl lg:text-6xl font-bold text-theme leading-tight">
        Especialidades tratadas <br />
      </h1>
      <p data-aos="fade-up" data-aos-duration="500" data-aos-delay="600" class="text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
        Soluciones adaptadas a las necesidades clínicas de cada paciente.
      </p>
    </div>

