---
import { Image } from "astro:assets";
import Insumo1 from "../../assets/catalog/insumo1.jpg";
import Insumo2 from "../../assets/catalog/insumo2.jpg";
import Insumo3 from "../../assets/catalog/insumo3.jpg";
import Insumo4 from "../../assets/catalog/insumo4.jpg";

const slideImages = [
  { image: Insumo1, alt: "Servicio de asistencia respiratoria SeAMeD S.A." },
  { image: Insumo2, alt: "Equipamiento de oxigenoterapia y CPAP" },
  { image: Insumo3, alt: "Soporte técnico y atención domiciliaria" },
  { image: Insumo4, alt: "Ventilación mecánica e insumos médicos" }
];
---

<section class="relative pt-12 pb-12 bg-surface w-full overflow-hidden border-b border-brand-gray/10">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
    
    <div class="flex flex-col gap-4">
      <!-- <span data-aos="fade-down" data-aos-duration="500" data-aos-delay="400" class="text-accent py-1 font-bold tracking-widest uppercase text-sm">
