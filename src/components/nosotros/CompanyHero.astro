---
// CompanyHero.astro
import Slide1 from "../../assets/slide1.jpeg";
---

<section class="relative pt-12 pb-12 bg-surface w-full">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-10 md:gap-16 items-center">
    
    <!-- Lado Izquierdo: Texto y Stats -->
    <div class="flex flex-col gap-2 md:gap-6">
      <span data-aos="fade-up" data-aos-duration="500" data-aos-delay="100" class="text-theme font-bold tracking-widest uppercase text-sm">
        Trayectoria y Compromiso
      </span>
      
      <h1 data-aos="fade-up" data-aos-duration="500" class="text-4xl md:text-6xl font-bold text-main leading-tight">
        Líderes en asistencia médica <br />
        <span class="text-theme">domiciliaria en Córdoba</span>
      </h1>
      
      <p data-aos="fade-up" data-aos-duration="500" data-aos-delay="100" class="text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
        Más de una década facilitando soluciones tecnológicas de alta
        complejidad para la recuperación y el bienestar del paciente en su
        hogar.
      </p>

      <!-- Stats de Autoridad (Grid Responsive) -->
      <div data-aos="fade-up" data-aos-duration="500" data-aos-delay="200" class="grid grid-cols-2 md:grid-cols-3 gap-6 mt-4">
        <div>
          <div class="text-2xl md:text-3xl font-bold text-main">+<span id="years">0</span></div>
          <div class="text-xs md:text-sm text-brand-gray uppercase tracking-widest">Años</div>
        </div>
        <div>
          <div class="text-2xl md:text-3xl font-bold text-main"><span id="certs">0</span>%</div>
          <div class="text-xs md:text-sm text-brand-gray uppercase tracking-widest">Certificados</div>
        </div>
        <div data-aos="fade-up" data-aos-duration="500" data-aos-delay="600" class="col-span-2 md:col-span-1">
          <div class="text-2xl md:text-3xl font-bold text-main">+<span id="patients">0</span></div>
          <div class="text-xs md:text-sm text-brand-gray uppercase tracking-widest">Pacientes</div>
        </div>
      </div>
    </div>

    <!-- Bloque Visual -->
    <div data-aos="fade-up" data-aos-duration="500" class="relative order-first md:order-last">
      <img
        src={Slide1.src}
        alt="Equipo técnico de SeAMeD S.A. en Córdoba"
        class="rounded-2xl shadow-2xl w-full h-[300px] md:h-[500px] object-cover"
        width="600"
        height="500"
        loading="eager"
      />
    </div>
  </div>
</section>

<script>
  // Tu lógica de JS permanece igual, pero asegúrate de envolverla en un 
  // evento de carga para que no intente buscar elementos antes de que existan
  document.addEventListener("astro:page-load", () => {
    const yearsElement = document.getElementById("years");
    const certsElement = document.getElementById("certs");
    const patientsElement = document.getElementById("patients");

    const targetYears = new Date().getFullYear() - 2010;
    const targetCerts = 100;
    const targetPatients = 1282;

    function animateCounter(element: HTMLElement | null, target: number) {
      if (!element) return;
      const duration = 2000;
      const startTime = performance.now();

      function update(currentTime: number) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easeProgress = progress < 0.5 ? 2 * progress * progress : 1 - Math.pow(-2 * progress + 2, 2) / 2;
        element.textContent = Math.floor(easeProgress * target).toString();
        if (progress < 1) requestAnimationFrame(update);
        else element.textContent = target.toString();
      }
      requestAnimationFrame(update);
    }

    animateCounter(yearsElement, targetYears);
    animateCounter(certsElement, targetCerts);
    animateCounter(patientsElement, targetPatients);
  });
</script>