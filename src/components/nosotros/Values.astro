---
import { ExternalLink, MapPin } from "lucide-astro";
import reviewsData from "../../data/nosotros/reviews.json";

const GOOGLE_REVIEWS_URL =
  reviewsData.googleReviewsUrl ||
  "https://www.google.com/maps/search/?api=1&query=SeAMeD+S.A.&query_place_id=0x9432a2a6e80f294d:0x527eaa34ded1a60f";
---

<section class="py-16 overflow-hidden bg-theme text-white relative">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-6">
      <!-- Botón de acceso directo arriba -->
      <div data-aos="fade-down" data-aos-duration="500">
        <a
          href={GOOGLE_REVIEWS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-[var(--color-accent)] text-white font-bold rounded-xl hover:brightness-110 transition-all shadow-lg shadow-[var(--color-accent)]/20 active:scale-95 text-sm"
        >
          <MapPin class="w-4 h-4" />
          <span>{reviewsData.botonTexto}</span>
          <ExternalLink class="w-4 h-4 opacity-75" />
        </a>
      </div>

      <!-- Título principal con acento -->
      <h2
        data-aos="fade-up"
        data-aos-duration="500"
        class="text-2xl sm:text-3xl md:text-4xl font-bold leading-tight"
      >
        {reviewsData.titulo}{" "}
        <span class="text-accent">{reviewsData.tituloAcento}</span>
      </h2>

      <!-- Bajada descriptiva -->
      <p
        data-aos="fade-up"
        data-aos-duration="500"
        data-aos-delay="150"
        class="text-blue-100 text-sm sm:text-base leading-relaxed max-w-xl"
      >
        {reviewsData.descripcion}
      </p>
    </div>
  </div>
</section>
