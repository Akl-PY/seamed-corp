---
// Values.astro
const values = [
  {
    title: "Excelencia Clínica",
    desc: "Nos comprometemos a entregar equipos de alta precisión, garantizando estándares médicos globales en cada unidad.",
  },
  {
    title: "Innovación Sostenible",
    desc: "Buscamos constantemente actualizar nuestro parque tecnológico con soluciones eficientes y amigables con el entorno.",
  },
  {
    title: "Compromiso Humano",
    desc: "Más allá de los equipos, nuestra prioridad es la seguridad y el bienestar de los pacientes y profesionales de la salud.",
  }
];
---

<section class="py-12 overflow-hidden bg-[var(--color-main)] text-white">
  <div class="container mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 data-aos="fade-up" data-aos-duration="500" class="text-3xl font-bold mb-4">Nuestro Propósito</h2>
      <p data-aos="fade-up" data-aos-duration="500" data-aos-delay="200" class="text-blue-100">
        Combinamos tecnología de vanguardia con un enfoque humano para transformar la experiencia en cuidados críticos.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {values.map((v, i) => (
        <div data-aos={i % 2 === 0 ? "fade-up" : "fade-down"} data-aos-duration="500" data-aos-delay={100 + i * 100} class="p-8 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 transition-colors">
          <div class="w-12 h-12 mb-6 rounded-full bg-[var(--color-theme)] flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{v.title}</h3>
          <p class="text-blue-100 text-sm leading-relaxed">{v.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>