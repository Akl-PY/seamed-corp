---
import { Star, ExternalLink, MapPin } from "lucide-astro";

const GOOGLE_REVIEWS_URL = "https://www.google.com/maps/search/?api=1&query=SeAMeD+S.A.&query_place_id=0x9432a2a6e80f294d:0x527eaa34ded1a60f";
---

<section class="py-16 overflow-hidden bg-theme text-white relative">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-6">
      
      <div data-aos="fade-down" data-aos-duration="500" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 text-xs font-semibold border border-white/10">
        <span class="text-yellow-400 flex items-center gap-1">
          <Star class="w-4 h-4 fill-yellow-400 text-yellow-400" />
          <span class="font-bold text-white">Google Reviews</span>
        </span>
        <span class="text-white/40">•</span>
        <span class="text-white/80">Opiniones de la Comunidad</span>
      </div>

      <!-- Título -->
      <h2 data-aos="fade-up" data-aos-duration="500" class="text-2xl sm:text-3xl md:text-4xl font-bold leading-tight">
        Conocé la experiencia de nuestros clientes en Google Maps
      </h2>

      <p data-aos="fade-up" data-aos-duration="500" data-aos-delay="150" class="text-blue-100 text-sm sm:text-base leading-relaxed max-w-xl">
        La confianza de las familias y profesionales de la salud es nuestro mayor respaldo. Podés consultar todas las opiniones reales o compartir tu experiencia.
      </p>

      <!-- Botón de acceso directo a las reseñas -->
      <div data-aos="fade-up" data-aos-duration="500" data-aos-delay="300" class="pt-2">
        <a 
          href={GOOGLE_REVIEWS_URL} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-8 py-4 bg-[var(--color-accent)] text-white font-bold rounded-xl hover:brightness-110 transition-all shadow-lg shadow-[var(--color-accent)]/20 active:scale-95 text-sm"
        >
          <MapPin class="w-4 h-4" />
          <span class="text-white">Ver opiniones de SeAMeD S.A.</span>
          <ExternalLink class="w-4 h-4 opacity-70" />
        </a>
      </div>

    </div>
  </div>
</section>