---
// TeamProfile.astro
import { Image } from 'astro:assets';
import JuanImage from "../../assets/juan.jpg";
import AnaImage from "../../assets/ana.jpg"; // Importa la imagen localmente

const team = [
  { 
    name: "Juan Pérez", 
    role: "Director Técnico", 
    specialty: "Ventilación Mecánica", 
    image: JuanImage
  },
  { 
    name: "Ana Gómez", 
    role: "Responsable de Logística", 
    specialty: "Oxigenoterapia", 
    image: AnaImage
  }
];
---

<section class="py-12 overflow-hidden bg-[var(--color-surface)]">
  <div class="container mx-auto px-6">
    <h2 data-aos="fade-up" data-aos-duration="500" class="text-3xl font-bold text-[var(--color-main)] mb-12">
      Nuestro Equipo
    </h2>

    <div class="grid md:grid-cols-2 gap-12">
      {team.map((member, i) => (
        <div data-aos={i % 2 === 0 ? "fade-right" : "fade-left"} data-aos-duration="500" data-aos-delay={100 + i * 100} class="flex gap-6 items-start p-6 bg-white rounded-xl shadow-sm border border-gray-100">
          <div class="size-24 shrink-0 rounded-full overflow-hidden bg-gray-100">
            <Image
              src={member.image}
              alt={member.name}
              width={200}
              height={200}
              class="w-full h-full object-cover"
            />
          </div>

          <div class="min-w-0 flex-1">
            <h3 class="text-lg font-bold text-[var(--color-main)]">
              {member.name}
            </h3>
            <p class="text-[var(--color-theme)] font-semibold text-sm">
              {member.role}
            </p>
            <p class="text-sm text-[var(--color-brand-gray)] mt-2">
              {member.specialty}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>