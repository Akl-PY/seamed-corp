---
// LocalTrust.astro
import { MapPin, Navigation, Star } from "lucide-astro";
import ubicacionData from "../../data/contacto/ubicacion.json";
---

<section class="py-12 bg-surface" id="ubicacion">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
    <div class="flex flex-col gap-6">
      <h2
        data-aos="fade-up"
        data-aos-duration="500"
        class="text-3xl md:text-4xl font-bold text-theme"
      >
        Estamos en <span class="text-accent"
          >{ubicacionData.titulo.replace("Estamos en ", "")}</span
        >
      </h2>

      <p
        data-aos="fade-up"
        data-aos-duration="500"
        data-aos-delay="200"
        class="text-muted leading-relaxed text-sm sm:text-base"
      >
        {ubicacionData.descripcion}
      </p>

      <div
        data-aos="fade-up"
        data-aos-duration="500"
        data-aos-delay="400"
        class="flex flex-col gap-4"
      >
        <address
          class="not-italic text-main font-semibold flex items-center gap-2"
        >
          <MapPin class="w-5 h-5 text-accent flex-shrink-0" />
          <span>Dirección: {ubicacionData.direccion}</span>
        </address>

        <!-- Rating informativo de Google Maps -->
        <div class="flex items-center gap-2 text-xs font-semibold text-muted">
          <div class="flex items-center text-amber-400">
            <Star class="w-4 h-4 fill-current" />
            <Star class="w-4 h-4 fill-current" />
            <Star class="w-4 h-4 fill-current" />
            <Star class="w-4 h-4 fill-current" />
            <Star class="w-4 h-4 fill-current" />
          </div>
          <span class="text-main font-bold">{ubicacionData.ratingPuntaje}</span>
          <span>{ubicacionData.ratingEtiqueta}</span>
        </div>
      </div>

      <!-- Botón Único de Google Maps -->
      <div class="pt-2">
        <a
          data-aos="fade-up"
          data-aos-duration="500"
          data-aos-delay={600}
          href={ubicacionData.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-theme text-white font-bold rounded-xl hover:bg-accent transition-all w-fit shadow-md active:scale-95 text-sm group"
        >
          <Navigation
            class="w-4 h-4 text-accent group-hover:text-white transition-colors"
          />
          <span>Ver en Google Maps y Opiniones</span>
        </a>
      </div>
    </div>

    <!-- Bloque de Mapa Diferido -->
    <div
      data-aos="flip-up"
      data-aos-duration="1000"
      data-aos-delay="600"
      class="relative w-full h-[380px] rounded-3xl overflow-hidden shadow-xl bg-gray-200 border border-brand-gray/15"
      id="map-container"
    >
      <iframe
        data-src={ubicacionData.embedMapUrl}
        class="w-full h-full z-20 border-0 opacity-0 transition-opacity duration-700"
        loading="lazy"
        title="Ubicación de SeAMeD S.A. en Google Maps"
        onload="this.style.opacity='1'"></iframe>
    </div>
  </div>
</section>

<script>
  function initLocalTrust() {
    const mapContainer = document.getElementById("map-container");
    if (mapContainer) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const iframe = entry.target.querySelector("iframe");
              if (iframe && !iframe.src) {
                iframe.src = iframe.dataset.src || "";
              }
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "100px" },
      );

      observer.observe(mapContainer);
    }
  }

  document.addEventListener("astro:page-load", initLocalTrust);
</script>
