---
// CompanyHero.astro
import { slide } from "astro:transitions";
import { SITE_CONFIG } from "../../config/site";

const contactDetails = [
  { label: "WhatsApp", value: "+54 9 351 52-26545", href: "https://wa.me/5493515226545" },
  { label: "Email", value: "ventas@seamed.com.ar", href: "mailto:ventas@seamed.com.ar" },
  { label: "Teléfono", value: SITE_CONFIG.organization.contactPoint?.telephone, href: `tel:${SITE_CONFIG.organization.contactPoint?.telephone}` },
];
---

<section class="py-12 bg-surface">
  <div class="container mx-auto px-6 grid md:grid-cols-2 gap-16 items-center overflow-hidden">
    
    <div class="flex flex-col gap-6">
      <h1 data-aos="fade-up" data-aos-duration="500" class="text-5xl md:text-6xl font-bold text-main leading-tight">
        Contacta con nosotros para asesorarte <span class="tracking-tighter uppercase text-theme">HOY</span>
      </h1>
      <p data-aos="fade-up" data-aos-duration="500" data-aos-delay="200" class="text-xl text-muted leading-relaxed">
        Nuestro equipo de expertos está listo para brindarte la mejor atención personalizada. 
        Solicita información sobre nuestros equipos o soporte técnico.
      </p>
    </div>

    <div data-aos="flip-up" data-aos-duration="1000" data-aos-delay="600" class="bg-white p-8 md:p-10 rounded-2xl shadow-xl border border-main/10">
      <h3 class="text-2xl font-bold text-main mb-1">Formulario de Contacto</h3>
      <p class="text-sm text-gray-500 mb-6">Respondemos en menos de 24 horas hábiles.</p>
      
      <form class="grid gap-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
           <input type="text" placeholder="Nombre completo" class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-theme/50 outline-none transition-all" required />
           <input type="email" placeholder="Correo electrónico" class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-theme/50 outline-none transition-all" required />
        </div>
        
        <input type="text" placeholder="Asunto" class="w-full border border-main/20 p-3 rounded-lg focus:ring-2 focus:ring-theme/50 outline-none transition-all" />
        
        <textarea placeholder="Tu mensaje..." class="w-full border border-main/20 p-3 rounded-lg min-h-[120px] resize-none focus:ring-2 focus:ring-theme/50 outline-none transition-all"></textarea>

        <div class="flex flex-col gap-3">
          <label class="flex items-center gap-3 cursor-pointer group">
            <input type="checkbox" class="w-4 h-4 cursor-pointer accent-theme" />
            <span class="text-sm text-main group-hover:text-theme transition-colors">Recibir copia del mensaje</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer group">
            <input type="checkbox" class="w-4 h-4 cursor-pointer accent-theme" required />
            <span class="text-sm text-main group-hover:text-theme transition-colors">Acepto la política de privacidad</span>
          </label>
        </div>

        <button type="submit" class="w-full bg-theme text-white font-bold py-4 rounded-lg hover:brightness-110 transition-all shadow-lg shadow-theme/20">
          Enviar Mensaje
        </button>
      </form>
    </div>

    <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-3 gap-8 pt-4 pb-2 border-t border-main/10">
      {contactDetails.map((item, i)=> (
        <a href={item.href} data-aos="fade-down" data-aos-duration="500" data-aos-delay={600 + i * 200} class="flex flex-col items-center text-center border border-transparent rounded-2xl hover:text-theme transition-colors hover:border-theme duration-500 active:scale-95">
          <span class="text-sm text-brand-gray uppercase tracking-widest mb-1">{item.label}</span>
          <span class="text-lg font-bold ">{item.value}</span>
        </a>
      ))}
    </div>
  </div>
</section>
