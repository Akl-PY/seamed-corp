---
// OtherContact.astro
import { Building2, Package, CreditCard, RotateCcw, PhoneCall, Mail, MessageSquare, Phone } from "lucide-astro";
import contactData from "../../data/contacto/info.json";

const iconMap: Record<string, any> = {
  package: Package,
  creditCard: CreditCard,
  rotateCcw: RotateCcw,
  building: Building2,
  message: MessageSquare,
  mail: Mail,
  phone: Phone,
};

// Filtramos los canales para la sección inferior
const otherChannels = contactData.canales.filter((c) => c.mostrarEnOtros);
---

<section class="overflow-hidden py-12 bg-surface">
  <div class="container mx-auto px-6">
    <div class="text-center mb-12">
      <h2 data-aos="fade-up" data-aos-duration="500" class="text-2xl sm:text-3xl font-bold text-theme mb-4">
        {contactData.otrosTitulo}
      </h2>
      <p data-aos="fade-up" data-aos-duration="500" data-aos-delay="200" class="text-muted max-w-xl mx-auto text-sm sm:text-base">
        {contactData.otrosBajada}
      </p>
    </div>

    <!-- Grid de canales secundarios -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {otherChannels.map((detail, i) => {
        const IconComponent = iconMap[detail.icono] || Building2;

        return (
          <div 
            data-aos={i % 2 === 0 ? "zoom-in-right" : "zoom-in-left"} 
            data-aos-duration="500" 
            data-aos-delay={100 + i * 120} 
            class="p-6 bg-surface border border-gray-100 rounded-2xl hover:border-[var(--color-accent)] transition-all duration-300 flex flex-col items-center justify-between text-center shadow-xs hover:shadow-xl group"
          >
            <div class="flex flex-col items-center w-full">
              <!-- Icono -->
              <div class="w-12 h-12 rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] flex items-center justify-center mb-4 group-hover:bg-[var(--color-accent)] group-hover:text-white transition-colors duration-300">
                <IconComponent class="w-6 h-6" />
              </div>

              <h3 class="font-bold text-[var(--color-main)] mb-4 text-base">{detail.label}</h3>
              
              <!-- Teléfonos -->
              {detail.phones.length > 0 && (
                <div class="flex flex-col gap-2 w-full mb-3">
                  {detail.phones.map((num) => {
                    const cleanNumber = num.replace(/\s|-/g, '');
                    const isFijo = num.startsWith("351 898");
                    return (
                      <a 
                        href={isFijo ? "tel:03518980811" : `tel:${cleanNumber}`}
                        title={`Llamar a ${detail.label}: ${num}`}
                        class="inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-bg hover:bg-[var(--color-accent)]/10 border border-transparent hover:border-[var(--color-accent)]/20 text-xs font-bold text-[var(--color-main)] hover:text-[var(--color-accent)] transition-all duration-200 cursor-pointer active:scale-95 group/link"
                      >
                        <PhoneCall class="w-3.5 h-3.5 text-[var(--color-accent)] group-hover/link:animate-bounce" />
                        <span>{num}</span>
                      </a>
                    );
                  })}
                </div>
              )}

              <!-- Correos Electrónicos -->
              {detail.emails.length > 0 && (
                <div class="flex flex-col gap-2 w-full">
                  {detail.emails.map((email) => (
                    <a 
                      href={`mailto:${email}`}
                      title={`Enviar correo a ${email}`}
                      class="inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-bg hover:bg-[var(--color-accent)]/10 border border-transparent hover:border-[var(--color-accent)]/20 text-[11px] font-semibold text-[var(--color-main)]/80 hover:text-[var(--color-accent)] transition-all duration-200 cursor-pointer break-all"
                    >
                      <Mail class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]" />
                      <span>{email}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>

            <span class="text-[10px] text-[var(--color-muted)] font-medium mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              Hacé clic para llamar o enviar mail
            </span>
          </div>
        );
      })}
    </div>
  </div>
</section>