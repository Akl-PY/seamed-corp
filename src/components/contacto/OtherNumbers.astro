---
// OtherNumbers.astro
const OtherContactDetails = [
  { label: "Oficina", value: "351 89-80-811", icon: "🏢" },
  { label: "Ventas y Alquiler", value: "351-5-226545", icon: "📦" },
  { label: "Pagos", value: "351-5-226190", icon: "💳" },
  { label: "Devoluciones", value: "351-6-236256", icon: "↩️" },
  { label: "Soporte Técnico", value: "351-5-226545 / 351-5-226313 / 351-6-772000", icon: "🛠️" },
];
---

<section class="py-12 bg-surface">
  <div class="container mx-auto px-6">
    <div class="text-center mb-12">
      <h2 data-aos="fade-up" data-aos-duration="500"  class="text-3xl font-bold text-[var(--color-main)] mb-4">Otros medios de contacto</h2>
      <p data-aos="fade-up" data-aos-duration="500" data-aos-delay="200" class="text-[var(--color-muted)] max-w-xl mx-auto">
        Además de nuestro formulario de contacto, puedes comunicarte con nosotros a través de los siguientes números para consultas específicas o asistencia inmediata.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-5 justify-between gap-6">
      {OtherContactDetails.map((detail, i) => (
        <div data-aos={i % 2 === 0 ? "fade-right" : "fade-left"} data-aos-duration="500" data-aos-delay={100 + i * 200} class="p-6 bg-[var(--color-surface)] border border-gray-100 rounded-2xl  hover:border-[var(--color-theme)] transition-colors flex flex-col items-center text-center">
          <span class="text-3xl mb-4">{detail.icon}</span>
          <h3 class="font-bold text-[var(--color-main)] mb-2">{detail.label}</h3>
          <a 
            href={`tel:${detail.value.split('/')[0].replace(/\s|-/g, '')}`} 
            class="text-[var(--color-theme)] font-semibold hover:underline break-words rounded-xl "
          >
            {detail.value}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>