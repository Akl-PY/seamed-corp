---
import { Image } from "astro:assets";
import Img1 from "../../assets/catalog/insumo1.jpg";
import Img2 from "../../assets/catalog/insumo2.jpg";

const patologias = [
  {
    title: "Diabetes",
    icon: "🩸",
    image: Img1,
    description: "Control de glucemia y dispositivos de infusión continua.",
    items: ["Tiras reactivas y glucómetros", "Agujas y jeringas para insulina", "Lancetas y sensores de monitoreo"]
  },
  {
    title: "Alimentación Enteral",
    icon: "🧪",
    image: Img2,
    description: "Soporte nutricional y accesorios de infusión.",
    items: ["Sondas nasogástricas y K-108", "Guías para bomba y gravedad", "Fórmulas nutricionales específicas"]
  },
  {
    title: "Acceso Vascular",
    icon: "🩺",
    image: Img1,
    description: "Cuidado de catéteres y terapia de infusión.",
    items: ["Catéteres centrales y periféricos", "Apositos transparentes con clorhexidina", "Kits de curación y conectores libres de aguja"]
  },
  {
    title: "Cirugía y Heridas",
    icon: "🩹",
    image: Img2,
    description: "Curación avanzada y descartables quirúrgicos.",
    items: ["Gasas, vendas y cintas hipoalergénicas", "Apósitos hidrocoloides y de plata", "Suturas y guantes estériles"]
  }
];
---

<section class="py-16 bg-bg">
  <div class="container mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold text-accent uppercase tracking-wider">Versión A - Vista Rápida</span>
      <h2 class="text-3xl font-bold text-main mt-1">Rubros y Patologías Tratadas</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {patologias.map((pat) => (
        <div class="flex flex-col justify-between bg-surface rounded-2xl border border-brand-gray/15 overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300">
          <div>
            <div class="relative h-40 overflow-hidden">
              <Image src={pat.image} alt={pat.title} class="w-full h-full object-cover" width={400} height={250} />
              <span class="absolute top-3 left-3 bg-bg/90 backdrop-blur-md px-3 py-1 rounded-full text-xs font-bold text-main shadow-sm">
                {pat.icon} {pat.title}
              </span>
            </div>

            <div class="p-5">
              <p class="text-xs text-muted mb-4">{pat.description}</p>
              
              <p class="text-[11px] font-bold text-main uppercase tracking-wider mb-2">Principales Insumos:</p>
              <ul class="space-y-1.5">
                {pat.items.map((item) => (
                  <li class="text-xs text-muted flex items-start gap-2">
                    <span class="text-accent font-bold">•</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="p-5 pt-0">
            <a href="#cotizar" class="inline-flex w-full items-center justify-center gap-1 py-2 px-3 rounded-lg bg-accent/10 hover:bg-accent text-accent hover:text-main text-xs font-bold transition-colors duration-200">
              Consultar este rubro →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>