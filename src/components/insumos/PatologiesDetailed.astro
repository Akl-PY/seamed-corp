---
// InsumosMedicos.astro - Catálogo especializado adaptado a los requerimientos
import { Image } from "astro:assets";
import cirugiaImagen from "../../assets/patologies/cirugia.avif";
import glucosaImagen from "../../assets/patologies/diabetes.jpg";
import alimentacionImagen from "../../assets/patologies/suero.jpg";
import respiratorioImagen from "../../assets/patologies/respiratorio.avif";
import vascularImagen from "../../assets/patologies/vascular.avif";

const rubrosDetallados = [
  {
    id: "diabetes",
    title: "Diabetes y Monitoreo",
    badge: "Control y Monitoreo",
    image: glucosaImagen,
    imagePosition: "object-cover",
    description: "Proporcionamos todos los elementos necesarios para el autocontrol de la glucemia, garantizando el abastecimiento de instituciones de salud, obras sociales y otros prestadores.",
    items: [
      { name: "Tiras Reactivas y Medidores", detail: "Sistemas de alta precisión con resultados en pocos segundos." },
      { name: "Agujas para Lapicera de Insulina", detail: "Bisel ultrasuave para aplicaciones prácticamente indoloras." },
      { name: "Monitoreo Continuo (CGM)", detail: "Sensores y accesorios para lectura sin pinchazos frecuentes." }
    ]
  },
  {
    id: "enteral",
    title: "Alimentación Enteral y Soporte Nutricional",
    badge: "Soporte Nutricional",
    image: alimentacionImagen,
    imagePosition: "object-cover object-bottom", // Recorta la parte superior de la bolsa
    description: "Insumos para administración de nutrición enteral por sonda en pacientes con incapacidad de ingesta oral.",
    items: [
      { name: "Sondas de Alimentación", detail: "Sondas nasogástricas de PVC, poliuretano y silicona de alta durabilidad." },
      { name: "Guías de Infusión", detail: "Guías para bombas continuas y opciones por gravedad." },
      { name: "Bolsas de Nutrición y Recipientes", detail: "Sistemas cerrados y abiertos para administración segura." },
      { name: "Botones y sondas de gastrostomía (PEG / Mic-Key)" },
      { name: "Bombas de infusión enteral" },
      { name: "Fórmulas nutricionales" },
      { name: "Jeringas Toomey / EnFit" }
    ]
  },
  {
    id: "vascular",
    title: "Acceso Vascular y Terapia de Infusión",
    badge: "Terapia Intravenosa",
    image: vascularImagen,
    imagePosition: "object-cover",
    description: "Material para la fijación, curación y mantenimiento de accesos venosos periféricos y centrales, minimizando el riesgo de infecciones asociadas al catéter.",
    items: [
      { name: "Fijadores y Apósitos Transparentes", detail: "Con tecnología respirable y gluconato de clorhexidina integrados." },
      { name: "Conectores Luer-Lock Libres de Aguja", detail: "Válvulas de acceso bi-direccionales de sistema cerrado." },
      { name: "Prolongadores y Llaves de 3 Vías", detail: "Sistemas estériles sin látex para infusión simultánea." },
      { name: "Catéteres intravenosos periféricos (Abocath)" },
      { name: "Agujas tipo Huber para puerto Port-a-Cath" },
      { name: "Kits estériles de curación e higiene de vía central" },
      { name: "Solución fisiológica en ampollas / Heparina para sellado" }
    ]
  },
  {
    id: "cirugia",
    title: "Cirugía",
    badge: "Área Quirúrgica",
    image: cirugiaImagen,
    imagePosition: "object-cover",
    description: "Insumos e instrumental descartable especializado para procedimientos quirúrgicos, curación avanzada de heridas complejas y manejo de drenajes.",
    items: [
      { name: "Suturas Quirúrgicas", detail: "Seda, nylon, Vicryl y PDS con agujas de alta precisión." },
      { name: "Apósitos de Curación Avanzada", detail: "Hidrocoloides, alginatos y espumas de poliuretano estériles." },
      { name: "Sistemas de Drenaje", detail: "Drenajes Jackson-Pratt, Redon y frascos de aspiración estéril." },
      { name: "Hojas y mangos de bisturí descartables estériles" },
      { name: "Gasas, compresas y vendas quirúrgicas" },
      { name: "Guantes quirúrgicos estériles libres de talco" }
    ]
  },
  {
    id: "respiratorio",
    title: "Respiratorio",
    badge: "Terapia Respiratoria",
    image: respiratorioImagen,
    imagePosition: "object-cover",
    description: "Equipamiento e insumos descartables para administración de oxígeno, humidificación, aeroterapia y manejo de vías aéreas en pacientes críticos y ambulatorios.",
    items: [
      { name: "Cánulas y Máscaras de O₂", detail: "Sistemas Venturi, con reservorio y cánulas nasales ultra suaves." },
      { name: "Aerocámaras e Inhaloterapia", detail: "Espaciadores estáticos y portátiles para adultos y pediatría." },
      { name: "Filtros y Humidificadores", detail: "Filtros HME antibacterianos/virales y vasos humidificadores." },
      { name: "Tubos endotraqueales y cánulas de traqueostomía" },
      { name: "Kits de nebulización a pistón y ultrasónicos" },
      { name: "Sensores de oximetría de pulso y oxímetros portátiles" }
    ]
  }
];
---

<section class="py-16 bg-surface">
  <div class="container mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-sky-900 mt-1">Nuestros principales productos</h2>
      <div class="w-16 h-1 bg-sky-600 mx-auto mt-3 rounded-full"></div>
    </div>

    <div class="space-y-16">
      {rubrosDetallados.map((rubro, index) => (
        <div class={`grid md:grid-cols-12 gap-8 lg:gap-12 items-center ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''}`}>
          
          <!-- Imagen -->
          <div class={`md:col-span-5 ${index % 2 !== 0 ? 'md:order-2' : ''}`}>
            <div class="relative h-72 sm:h-80 md:h-[340px] rounded-3xl overflow-hidden shadow-lg border border-sky-100 bg-sky-50/30">
              <Image 
                src={rubro.image} 
                alt={rubro.title} 
                class={`w-full h-full ${rubro.imagePosition || 'object-cover'}`} 
                width={600} 
                height={500} 
              />
            </div>
          </div>

          <!-- Contenido -->
          <div class={`md:col-span-7 ${index % 2 !== 0 ? 'md:order-1' : ''}`}>
            <span class="inline-block text-xs font-bold text-sky-700 bg-sky-100/80 border border-sky-200/70 px-3.5 py-1 rounded-full uppercase tracking-wider">
              {rubro.badge}
            </span>
            <h3 class="text-2xl font-bold text-sky-950 mt-3 mb-2">{rubro.title}</h3>
            <p class="text-sm text-slate-600 mb-6 leading-relaxed">{rubro.description}</p>

            <!-- Lista de Ítems Sueltos (Estructura dinámica con toque azul) -->
            <div class="grid sm:grid-cols-2 gap-2.5 mb-6">
              {rubro.items.map((item) => (
                <div class="flex items-start gap-2.5 p-2.5 rounded-xl bg-sky-50/60 border border-sky-100/90 hover:border-sky-200 transition-colors">
                  <span class="w-2 h-2 rounded-full bg-sky-500 mt-1.5 flex-shrink-0"></span>
                  <div>
                    <p class="text-xs font-semibold text-slate-900">{item.name}</p>
                    {item.detail && (
                      <p class="text-[11px] text-slate-500 leading-snug mt-0.5">{item.detail}</p>
                    )}
                  </div>
                </div>
              ))}
            </div>

            <!-- Botón de Acción -->
            <a 
              href="/cotizar" 
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sky-600 text-white text-xs font-bold shadow-sm hover:bg-sky-700 hover:shadow transition-all duration-200"
            >
              Solicitar Insumos de {rubro.title.split(' ')[0]} →
            </a>
          </div>

        </div>
      ))}
    </div>
  </div>
</section>