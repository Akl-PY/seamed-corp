---
import "../../styles/global.css";
import Seo from "../components/Seo.astro";
// import 'aos/dist/aos.css'; 
import type {PropsOP as SeoProps} from "../types/seo";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
export type Component = AstroComponentFactory | HTMLElement | any;
export interface LayoutConfigProps{
    logo?:Component
    footer?:Component
    header?:Component
} 
export interface ConfigProps{
    logo?:boolean
    footer?:boolean
    header?:boolean
}
export type Props ={
    layoutConfig?:LayoutConfigProps,
    config?:ConfigProps
    seo:SeoProps,
    
}

const {seo, layoutConfig, config ={logo:false, footer:false, header:false}} = Astro.props as Props

const FooterComponent = layoutConfig?.footer
const LogoComponent = layoutConfig?.logo
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <link rel="icon"  sizes="32x32" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
    
        <meta name="generator" content={Astro.generator} />
        
        <Seo {...seo}/>
